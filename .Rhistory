VEG_total_FL = VEG_purchased_grams * (FLper100gram_final / 100),
PHD_total_FL = PHD_purchased_grams * (FLper100gram_final / 100),
CURRENT_total_FL = CURRENT_purchased_grams * (FLper100gram_final / 100))
