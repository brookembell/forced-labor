select(foodgroup,
HUS_total_FL,
MED_total_FL,
VEG_total_FL,
PHD_total_FL,
CURRENT_total_FL) %>%
arrange(foodgroup)
min_results_summary_list[[i]] <-
min_results_list[[i]] %>%
summarise(across(where(is.numeric), ~ sum(.x, na.rm = TRUE))) %>%
mutate(simulation_name = paste0(names(min_list)[[i]]))
# export
