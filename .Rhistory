for (i in 1:nrow(patterns4)) {
max_list[[paste0("max_", patterns4$foodgroup[i])]] <-
patterns4 %>%
mutate(FLper100gram_final = ifelse(foodgroup == foodgroup[i], FLper100gram_max, FLper100gram))
}
min_list[[1]]
